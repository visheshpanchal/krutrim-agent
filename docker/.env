# One shared env file for the whole project — backend, frontend, and
# docker-compose all read this same file (via symlinks: backend/.env,
# apps/web/.env.local, docker/.env). Edit values here only. See .env.example
# for the full list of vars and what each one does.

OPENROUTER_API_KEY="sk-dev-local-only"
OPENROUTER_BASE_URL=http://host.docker.internal:4000/
# Dev-proxy (krutrim-dev-proxy-server) auth: when OPENROUTER_BASE_URL points at
# the local litellm proxy, requests must carry ITS master key, not a real
# OpenRouter key — the proxy holds the real key server-side and forwards to
# OpenRouter itself. Must match LITELLM_MASTER_KEY in that repo's own .env.
# NOTE: this must be a name OTHER than OPENROUTER_API_KEY — your shell profile
# (~/.zshrc) globally exports the real OPENROUTER_API_KEY, and docker-compose's
# ${VAR} substitution always prefers the shell's environment over this file's
# value for that same name, so setting OPENROUTER_API_KEY here directly is
# silently ignored.
LITELLM_MASTER_KEY=sk-dev-local-only

DEV_MODE=true
TAVILY_SEARCH_API_BASE=http://host.docker.internal:4000/
TAVILY_API_KEY='This is api key.'

LANGFUSE_SECRET_KEY="sk-lf-81dd822c-b6c3-41ff-a323-5abb1e3e7e47"
LANGFUSE_PUBLIC_KEY="pk-lf-2e7ddf18-fee1-4a24-827c-53853a54a209"
LANGFUSE_BASE_URL="http://localhost:3000"

VITE_BACKEND_URL=http://localhost:8000

# Blank REDIS_USER = password-only auth (matches Redis's plain --requirepass
# model used by docker/docker-compose.yml's redis service — there's no ACL
# user actually named "test"/"default" configured, just a password on the
# built-in default user). Leave REDIS_USER blank unless you've set up Redis
# ACL users yourself.
REDIS_USER=
REDIS_PASSWORD=test
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0

# CORS
KRUTRIM_AGENT_CORS_ORIGINS=["http://localhost:4200","http://localhost:5173","http://localhost:4300"]

# Vector Storage
KRUTRIM_AGENT_VECTOR_STORE_BACKEND="qdrant"
# BARE name — docker-compose reads COMPOSE_PROFILES, never the KRUTRIM_AGENT_
# prefixed form (see .env.example "KEY NAMING"). Without this the `qdrant`
# service (profiles: ["qdrant"]) never starts and `http://qdrant:6333` fails
# DNS resolution inside the backend container.
COMPOSE_PROFILES=qdrant
KRUTRIM_AGENT_QDRANT_URL=http://qdrant:6333

# RagSystem
KRUTRIM_AGENT_RAG_INJECTION_ENABLED=True
KRUTRIM_AGENT_RETRIEVAL_STRATEGY=hybrid
KRUTRIM_AGENT_RAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Logging — dev: DEBUG in the files, INFO on the console stays readable while
# every DEBUG step still lands in ~/.krutrim_agent/logs/{server,worker}/.
# (DEV_MODE=true already forces DEBUG on both sinks; these make it explicit
# and let you dial the console back up/down without touching DEV_MODE.)
KRUTRIM_AGENT_LOG_LEVEL=DEBUG
KRUTRIM_AGENT_LOG_CONSOLE_LEVEL=DEBUG
KRUTRIM_AGENT_LOG_ROTATION=1 day
KRUTRIM_AGENT_LOG_RETENTION=7 days
KRUTRIM_AGENT_LOG_BACKTRACE=true

# Dev container settings
WATCHFILES_FORCE_POLLING=true
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true